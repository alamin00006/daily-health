# Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.
# Generate a random secret:  openssl rand -base64 32
# Generate an encryption key: echo "1:$(openssl rand -base64 32)"

# --- Server -------------------------------------------------------------------
# staging = demo data allowed, Swagger at /api/docs. production = real users, no seed, no Swagger.
APP_ENV=staging
PORT=3000
LOG_LEVEL=info
# The API's domain (its DNS A record points at this VPS).
API_DOMAIN=manas.nigarfashionworld.com
# Let's Encrypt sends certificate expiry warnings here.
LETSENCRYPT_EMAIL=you@example.com
# Browser origins of the web panel (comma separated).
CORS_ORIGINS=https://panel.example.com
# Nginx sits in front of the API.
TRUST_PROXY_HOPS=1
# Port on 127.0.0.1 where the VPS's own Nginx reaches the API (way 1).
API_HOST_PORT=3010

# --- Database and Redis (inside Docker; never exposed) --------------------------
POSTGRES_USER=daily_health
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=daily_health
# Same user / password / db as above; host "postgres" is the container.
DATABASE_URL=postgresql://daily_health:REPLACE_WITH_THE_SAME_PASSWORD@postgres:5432/daily_health
REDIS_URL=redis://redis:6379

# --- Secrets: new ones for this server, never the ones from your PC ------------
# Losing ENCRYPTION_KEYS makes encrypted health data unreadable: keep a copy in a password manager.
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
ENCRYPTION_ACTIVE_KEY_VERSION=1
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
OTP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- Files: Cloudflare R2 (two buckets; the private one has NO public access) ---
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=
S3_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=daily-health-public
STORAGE_PRIVATE_BUCKET=daily-health-private
STORAGE_ENDPOINT=
PUBLIC_FILES_BASE_URL=https://cdn.example.com
PRIVATE_FILE_URL_TTL_SECONDS=600

# --- Links that point back at this API ------------------------------------------
HEALTH_CARD_BASE_URL=https://manas.nigarfashionworld.com/api/v1/health-cards
PAYMENT_CALLBACK_BASE_URL=https://manas.nigarfashionworld.com/api/v1
PAYMENT_APP_RETURN_URL=dailyhealth://payment-result

# --- Email (Gmail app password) ----------------------------------------------------
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=দৈনিক স্বাস্থ্য <your-address@gmail.com>

# --- SMS (BulkSMSBD; whitelist this VPS's IP in their dashboard if they ask) ------
SMS_API_KEY_VALUE=
SMS_SENDER_ID=
SMS_API_HOST_SITE=bulksmsbd.net

# --- Push --------------------------------------------------------------------------
EXPO_PUSH_ACCESS_TOKEN=

# --- Payments (sandbox until the merchant account is live) ----------------------
PAYMENT_GATEWAY=SHURJOPAY
PLATFORM_FEE_PERCENT=10
SHURJOPAY_BASE_URL=https://sandbox.shurjopayment.com/api
SHURJOPAY_USERNAME=sp_sandbox
SHURJOPAY_PASSWORD=
SHURJOPAY_PREFIX=sp
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- Video (Agora) ---------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=7200
