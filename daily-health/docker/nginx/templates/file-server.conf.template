# Serves STORAGE_ROOT_DIR (mounted at /srv/storage). The official nginx image
# runs envsubst on *.template files, filling in ${FILE_URL_SIGNING_SECRET}.
# Must match LocalDiskStorageService.getUrl() in src/core/storage.

server {
    listen 80;
    server_name _;

    # Read-only file server: uploads go through the API.
    client_max_body_size 1k;
    add_header X-Content-Type-Options nosniff always;

    # Public files: file names are random uuids, so they never change -> cache forever.
    location /public/ {
        alias /srv/storage/public/;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Private files: only with a valid, unexpired signature issued by the API
    # after it has checked ProfileMember permissions.
    location /private/ {
        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${FILE_URL_SIGNING_SECRET}";

        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        alias /srv/storage/private/;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        return 404;
    }
}
