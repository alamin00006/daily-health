# Copy to .env for local development. Validated at startup by
# src/core/config/environment-variables.schema.ts (the app refuses to start if invalid).

# development | staging | production  (Swagger /docs only in development and staging)
APP_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated browser origins (web panel). Mobile apps do not need CORS.
CORS_ORIGINS=http://localhost:3001
# Number of reverse proxies in front of the API (production behind Nginx: 1).
TRUST_PROXY_HOPS=0

# docker-compose.yml
POSTGRES_USER=daily_health
POSTGRES_PASSWORD=daily_health
POSTGRES_DB=daily_health
POSTGRES_PORT=5432
REDIS_PORT=6379

# Prisma (runtime + CLI). No ?schema= param: every model is schema-qualified via @@schema.
DATABASE_URL=postgresql://daily_health:daily_health@localhost:5432/daily_health

REDIS_URL=redis://localhost:6379

# Column encryption (AES-256-GCM). Format: <version>:<base64 32-byte key>, comma-separated.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change or remove a key that existing data still uses; add a new version instead.
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
ENCRYPTION_ACTIVE_KEY_VERSION=1

# File storage (CLAUDE.md §5): two buckets in an S3-compatible store.
# STORAGE_PROVIDER=R2 (Cloudflare, now) or S3 (AWS). Switching = these settings + copying both buckets.
STORAGE_PROVIDER=R2
# R2: Cloudflare dashboard → R2 → account id; S3: leave empty.
R2_ACCOUNT_ID=
# S3: the bucket region (e.g. ap-southeast-1); R2: leave empty.
S3_REGION=
# R2: R2 → Manage API tokens, "Object Read & Write" on both buckets. S3: IAM user access key.
STORAGE_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
# Lowercase letters, digits and hyphens only.
STORAGE_PUBLIC_BUCKET=daily-health-public
STORAGE_PRIVATE_BUCKET=daily-health-private
# Optional endpoint override (e.g. an EU R2 bucket: https://<account>.eu.r2.cloudflarestorage.com).
STORAGE_ENDPOINT=
# The public bucket's CDN domain: R2 custom domain, or CloudFront in front of S3.
PUBLIC_FILES_BASE_URL=https://cdn.example.com
# Private file link lifetime (presigned URL), 300-900 seconds.
PRIVATE_FILE_URL_TTL_SECONDS=600

# URL printed in health card QR codes: <base>/<qrToken>
HEALTH_CARD_BASE_URL=http://localhost:3000/api/v1/health-cards

# Email (nodemailer SMTP). Locally Mailpit from docker-compose catches everything:
# inbox at http://localhost:8025. In production use your SMTP provider (port 465 => SMTP_SECURE=true).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave both empty for Mailpit.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=দৈনিক স্বাস্থ্য <no-reply@daily-health.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Auth. Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Access token lifetime, 60-3600 seconds.
ACCESS_TOKEN_TTL_SECONDS=900
# Sliding refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=60
# HMAC key for stored OTP codes.
OTP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# NestJS Observe (optional): written by `npx @nestjs/observe link`.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Push notifications through Expo. Leave empty unless the Expo project turns on
# "Enhanced push security".
EXPO_PUSH_ACCESS_TOKEN=

# Payments through an aggregator (bKash, Nagad, Rocket, cards). Switch with PAYMENT_GATEWAY;
# only the chosen gateway's credentials are required.
PAYMENT_GATEWAY=SHURJOPAY
# Public base of this API as the gateway and the phone's browser reach it (return/IPN URLs).
# Locally with the Android emulator, http://localhost:3000/api/v1 works through `adb reverse`.
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/api/v1
# The app's deep link the return page redirects to.
PAYMENT_APP_RETURN_URL=dailyhealth://payment-result
# Platform's share of every payment in percent; the provider earns the rest.
PLATFORM_FEE_PERCENT=10
# shurjoPay sandbox values are public (shurjopay.com.bd developer docs). Use the merchant
# credentials and prefix from shurjoPay in production, with https://engine.shurjopayment.com/api.
SHURJOPAY_BASE_URL=https://sandbox.shurjopayment.com/api
SHURJOPAY_USERNAME=sp_sandbox
SHURJOPAY_PASSWORD=REPLACE_WITH_SHURJOPAY_PASSWORD
SHURJOPAY_PREFIX=sp
# SSLCommerz sandbox: register a free sandbox store at developer.sslcommerz.com.
# Production base URL: https://securepay.sslcommerz.com
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Agora video calls (console.agora.io → create a project with "Secured mode: APP ID + Token",
# then copy the App ID and the primary App Certificate). Leave both empty to run without video;
# chat consults still work. The certificate stays on the server; apps only get short-lived tokens.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=7200
