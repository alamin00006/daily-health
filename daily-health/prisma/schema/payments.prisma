// modules/payments: payments through an aggregator (shurjoPay or SSLCommerz), refunds,
// provider earnings and payouts (erd.md → "পেমেন্ট ও পেআউট"). User, profile, provider
// and appointment ids are plain uuids (`ref auth.User`, `ref users.PatientProfile`, …).

enum PaymentPurpose {
  APPOINTMENT
  QUICK_CONSULT
  DIET_PLAN
  /// A HealthStore order (shop module).
  ORDER

  @@schema("payments")
}

/// The aggregator that took the payment (switch with PAYMENT_GATEWAY).
enum PaymentGatewayName {
  SHURJOPAY
  SSLCOMMERZ

  @@schema("payments")
}

/// What the payer used inside the gateway's page.
enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  UPAY
  CARD
  OTHER

  @@schema("payments")
}

enum PaymentStatus {
  /// Checkout opened, not paid yet.
  INITIATED
  SUCCESS
  FAILED
  /// Abandoned, or replaced by a newer attempt for the same thing.
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@schema("payments")
}

enum GatewayTransactionKind {
  INITIATE
  VERIFY
  RETURN
  IPN
  REFUND

  @@schema("payments")
}

enum RefundStatus {
  /// Waiting: sent to the gateway, or for an admin (gateways without a refund API).
  REQUESTED
  PROCESSED
  FAILED

  @@schema("payments")
}

enum RefundRequester {
  SYSTEM
  ADMIN

  @@schema("payments")
}

enum EarningKind {
  EARNING
  /// Negative: a refund taken back from the provider.
  REFUND_ADJUSTMENT

  @@schema("payments")
}

enum PayoutMethod {
  BKASH
  NAGAD
  BANK

  @@schema("payments")
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED

  @@schema("payments")
}

/// One payment attempt. Only one INITIATED or SUCCESS payment per (purpose, referenceId):
/// partial unique index in the migration.
model Payment {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// "RC-2611-0042": the receipt number shown to people.
  invoiceNo         String             @unique
  /// ref auth.User
  payerUserId       String             @db.Uuid
  /// ref users.PatientProfile (whose care it pays for)
  patientId         String             @db.Uuid
  purpose           PaymentPurpose
  /// appointment or consultation id
  referenceId       String             @db.Uuid
  /// ref providers.Provider; who earns from it
  providerId        String?            @db.Uuid
  /// "ডা. ফারহানা ইসলাম, চেম্বার ১১ নভেম্বর"
  description       String
  /// What the payer is charged (listAmount minus discountAmount).
  amount            Decimal            @db.Decimal(10, 2)
  /// The price before any coupon; provider earnings are worked out from this.
  listAmount        Decimal            @db.Decimal(10, 2)
  /// Coupon discount, paid for by the platform (owner's decision, 2026-11-27).
  discountAmount    Decimal            @default(0) @db.Decimal(10, 2)
  currency          String             @default("BDT")
  gateway           PaymentGatewayName
  method            PaymentMethod?
  status            PaymentStatus      @default(INITIATED)
  /// The gateway's id for this checkout (shurjoPay sp_order_id, SSLCommerz sessionkey).
  gatewayPaymentId  String?            @unique
  /// The bank / wallet transaction id once paid.
  gatewayTrxId      String?
  checkoutUrl       String?
  /// The gateway checkout stops working after this.
  checkoutExpiresAt DateTime?          @db.Timestamptz(3)
  paidAt            DateTime?          @db.Timestamptz(3)
  failureReason     String?
  refundedAmount    Decimal            @default(0) @db.Decimal(10, 2)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  transactions GatewayTransaction[]
  refunds      Refund[]
  earnings     ProviderEarning[]
  redemption   CouponRedemption?

  @@index([payerUserId, createdAt(sort: Desc)])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([purpose, referenceId])
  @@index([status, createdAt])
  @@schema("payments")
}

/// Every call to and from the gateway, as it was (no secrets: tokens and passwords are stripped).
model GatewayTransaction {
  id               String                 @id @default(uuid(7)) @db.Uuid
  paymentId        String                 @db.Uuid
  kind             GatewayTransactionKind
  gatewayPaymentId String?
  gatewayTrxId     String?
  /// The gateway's own status text or code.
  status           String?
  rawRequest       Json?
  rawResponse      Json?
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@schema("payments")
}

model Refund {
  id                String          @id @default(uuid(7)) @db.Uuid
  paymentId         String          @db.Uuid
  amount            Decimal         @db.Decimal(10, 2)
  reason            String
  status            RefundStatus    @default(REQUESTED)
  requestedBy       RefundRequester
  gatewayRefundId   String?
  failureReason     String?
  /// ref auth.User (admin who completed a manual refund)
  processedByUserId String?         @db.Uuid
  processedAt       DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  payment    Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  adjustment ProviderEarning?

  @@index([status, createdAt])
  @@schema("payments")
}

/// What a provider earns from a payment (EARNING), or gives back for a refund (REFUND_ADJUSTMENT,
/// negative). Settled by a Payout; a paid Payout is never edited.
model ProviderEarning {
  id          String      @id @default(uuid(7)) @db.Uuid
  /// ref providers.Provider
  providerId  String      @db.Uuid
  paymentId   String      @db.Uuid
  refundId    String?     @unique @db.Uuid
  kind        EarningKind
  gross       Decimal     @db.Decimal(10, 2)
  platformFee Decimal     @db.Decimal(10, 2)
  net         Decimal     @db.Decimal(10, 2)
  payoutId    String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund  Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)
  payout  Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([providerId, payoutId, createdAt])
  @@schema("payments")
}

/// Money sent to a provider for their unsettled earnings up to periodEnd.
model Payout {
  id              String       @id @default(uuid(7)) @db.Uuid
  /// "ST-2611-0003" (settlement)
  payoutNo        String       @unique
  /// ref providers.Provider
  providerId      String       @db.Uuid
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  /// Sum of the settled net amounts (refund adjustments included).
  amount          Decimal      @db.Decimal(10, 2)
  method          PayoutMethod
  /// "017XXXXX123" / "XXXX4521": never the full number.
  accountMasked   String
  status          PayoutStatus @default(PENDING)
  /// bKash TrxID or bank reference, entered when paid.
  reference       String?
  /// ref auth.User
  createdByUserId String       @db.Uuid
  /// ref auth.User
  paidByUserId    String?      @db.Uuid
  paidAt          DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  earnings ProviderEarning[]

  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@schema("payments")
}

/// Where a provider wants to be paid. The account number is encrypted (core/crypto).
model ProviderPayoutAccount {
  /// ref providers.Provider
  providerId         String       @id @db.Uuid
  method             PayoutMethod
  accountName        String
  /// enc
  accountNumberEnc   Bytes
  /// Shown in lists: "4521".
  accountNumberLast4 String
  bankName           String?
  branchName         String?
  routingNumber      String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  @@schema("payments")
}

enum CouponDiscountType {
  /// discountValue is a percentage (1–100), capped by maxDiscount when set.
  PERCENT
  /// discountValue is a fixed amount in BDT.
  FLAT

  @@schema("payments")
}

enum CouponClaimSource {
  /// Typed into the sign-up form (Roadmap doc, 2026-11-26).
  SIGNUP

  @@schema("payments")
}

/// A discount code made by admins in the panel. People claim it (at sign-up for now);
/// a claim is spent on a later payment.
model Coupon {
  id              String             @id @default(uuid(7)) @db.Uuid
  /// "WELCOME50": uppercase letters, digits and "-", 3–32 chars (CHECK in the migration).
  code            String             @unique
  /// Shown to the person: "নতুনদের জন্য ৫০ টাকা ছাড়"
  title           String
  discountType    CouponDiscountType
  discountValue   Decimal            @db.Decimal(10, 2)
  /// Cap for a PERCENT coupon.
  maxDiscount     Decimal?           @db.Decimal(10, 2)
  /// The payment must be at least this much.
  minAmount       Decimal?           @db.Decimal(10, 2)
  /// What it can pay for; empty = everything.
  appliesTo       PaymentPurpose[]
  startsAt        DateTime?          @db.Timestamptz(3)
  endsAt          DateTime?          @db.Timestamptz(3)
  /// How many people can claim it; null = no limit.
  maxClaims       Int?
  claimCount      Int                @default(0)
  /// Payments one claim can be used on.
  usesPerClaim    Int                @default(1)
  isActive        Boolean            @default(true)
  /// ref auth.User
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  claims      CouponClaim[]
  redemptions CouponRedemption[]

  @@index([createdAt(sort: Desc)])
  @@schema("payments")
}

/// One person's claim on a coupon; one per coupon and person.
model CouponClaim {
  id        String            @id @default(uuid(7)) @db.Uuid
  couponId  String            @db.Uuid
  coupon    Coupon            @relation(fields: [couponId], references: [id], onDelete: Restrict)
  /// ref auth.User
  userId    String            @db.Uuid
  source    CouponClaimSource
  usesLeft  Int
  claimedAt DateTime          @default(now()) @db.Timestamptz(3)

  redemptions CouponRedemption[]

  @@unique([couponId, userId])
  @@index([userId, claimedAt(sort: Desc)])
  @@schema("payments")
}

enum CouponRedemptionStatus {
  /// The checkout is open; the use is held.
  RESERVED
  /// The payment went through.
  USED
  /// The payment failed, was abandoned or fully refunded; the use went back to the claim.
  RELEASED

  @@schema("payments")
}

/// One use of a claim on one payment. Holding the use while the checkout is open
/// stops one claim being spent on two payments at once.
model CouponRedemption {
  id             String                 @id @default(uuid(7)) @db.Uuid
  claimId        String                 @db.Uuid
  claim          CouponClaim            @relation(fields: [claimId], references: [id], onDelete: Restrict)
  couponId       String                 @db.Uuid
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  paymentId      String                 @unique @db.Uuid
  payment        Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  discountAmount Decimal                @db.Decimal(10, 2)
  status         CouponRedemptionStatus @default(RESERVED)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  @@index([claimId])
  @@index([couponId, status])
  @@schema("payments")
}
