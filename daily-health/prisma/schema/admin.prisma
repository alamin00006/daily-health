// modules/admin: audit log of health-data access and staff accounts
// (erd.md → "আকস্মিক সেবা, কনটেন্ট ও অ্যাডমিন"). User ids are plain uuids.

/// Written from `audit.*` events of every module. `meta` never holds health
/// values, names, emails or phone numbers.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// ref auth.User; null for an anonymous actor (health card scan).
  actorUserId String?  @db.Uuid
  /// ref users.PatientProfile: whose data.
  patientId   String   @db.Uuid
  /// "condition.view", "womens-health.period.create"
  action      String
  entityType  String
  entityId    String
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([patientId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@schema("admin")
}

/// A MODERATOR or ADMIN account: the readable staff ID (`MR-2611-0001`,
/// `AS-2611-0001`) and the name shown in the panel. The role itself lives on
/// auth.User so the access guard can read it.
model StaffMember {
  /// ref auth.User
  userId        String   @id @db.Uuid
  staffCode     String   @unique
  fullName      String
  /// ref auth.User; null for the first admin (seed / bootstrap).
  addedByUserId String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@schema("admin")
}

/// One row (id = 1): the look of the mobile app, set by admins in the panel.
model AppSetting {
  id              Int      @id @default(1)
  /// "#0f5c5a"; white text on it must stay readable (checked by the API).
  primaryColor    String   @default("#0f5c5a")
  /// ref auth.User
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@schema("admin")
}

/// Append-only history of primary colour changes.
model AppSettingChange {
  id              String   @id @default(uuid(7)) @db.Uuid
  fromColor       String
  toColor         String
  /// ref auth.User
  changedByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@schema("admin")
}
