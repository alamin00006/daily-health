// modules/shop: HealthStore (erd.md → "হেলথস্টোর (শপ)"). Our own stock and our own
// delivery. User, profile and prescription ids are plain uuids (`ref …`).

enum CategoryBadge {
  TRENDING
  MUST_HAVE
  POPULAR
  FEATURED
  BEST_SELLER

  @@schema("shop")
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
  EXPIRED
  RETURNED

  @@schema("shop")
}

enum OrderPaymentMethod {
  ONLINE
  CASH_ON_DELIVERY

  @@schema("shop")
}

enum PrescriptionCheck {
  NOT_NEEDED
  AWAITING_PRESCRIPTION
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@schema("shop")
}

enum StockMovementReason {
  RESTOCK
  ORDER
  ORDER_RELEASED
  RETURNED
  ADJUSTMENT
  DAMAGED
  EXPIRED_STOCK

  @@schema("shop")
}

enum BannerLinkType {
  NONE
  CATEGORY
  PRODUCT
  BRAND
  URL

  @@schema("shop")
}

/// One row (id = 1): the shop's on/off switch and rules, set by admins.
model ShopSetting {
  id                    Int      @id @default(1)
  /// Off: the app hides the shop and the public shop API answers SHOP_DISABLED.
  enabled               Boolean  @default(false)
  cashOnDeliveryEnabled Boolean  @default(true)
  minOrderAmount        Decimal  @default(0) @db.Decimal(10, 2)
  /// Free delivery from this subtotal; null = never.
  freeDeliveryFrom      Decimal? @db.Decimal(10, 2)
  paymentHoldMinutes    Int      @default(15)
  /// ref auth.User
  updatedByUserId       String?  @db.Uuid
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@schema("shop")
}

/// Append-only history of ShopSetting changes.
model ShopSettingChange {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// { field: [before, after] }
  changes         Json
  /// ref auth.User
  changedByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@schema("shop")
}

model ProductCategory {
  id              String         @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String         @unique
  badge           CategoryBadge?
  /// Public WebP.
  imageStorageKey String?
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  showOnHome      Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([isActive, sortOrder])
  @@schema("shop")
}

model Brand {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String
  slug           String   @unique
  /// Public WebP.
  logoStorageKey String?
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([isActive, isFeatured, sortOrder])
  @@schema("shop")
}

/// price <= mrp, stockQty >= 0 (CHECKs in the migration). Name search uses pg_trgm.
model Product {
  id                   String   @id @default(uuid(7)) @db.Uuid
  /// Our stock-keeping code, e.g. "NAPA-500-10".
  sku                  String   @unique
  name                 String
  genericName          String?
  strength             String?
  dosageForm           String?
  packSize             String?
  manufacturer         String?
  description          String?
  categoryId           String   @db.Uuid
  brandId              String?  @db.Uuid
  mrp                  Decimal  @db.Decimal(10, 2)
  price                Decimal  @db.Decimal(10, 2)
  /// Free to sell: already lowered by placed and unpaid (held) orders.
  stockQty             Int      @default(0)
  lowStockThreshold    Int      @default(5)
  maxPerOrder          Int      @default(10)
  requiresPrescription Boolean  @default(false)
  isTrending           Boolean  @default(false)
  isActive             Boolean  @default(true)
  /// Public WebP.
  imageStorageKey      String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  category       ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([isActive, isTrending])
  @@schema("shop")
}

/// Every change of Product.stockQty, with the balance after it (inventory ledger).
model StockMovement {
  id           String              @id @default(uuid(7)) @db.Uuid
  productId    String              @db.Uuid
  change       Int
  balanceAfter Int
  reason       StockMovementReason
  orderId      String?             @db.Uuid
  note         String?
  /// ref auth.User (staff); null when an order moved it.
  byUserId     String?             @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@schema("shop")
}

/// The buyer's cart, kept on the server so it follows them across phones.
model CartItem {
  /// ref auth.User
  userId    String   @db.Uuid
  productId String   @db.Uuid
  qty       Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@schema("shop")
}

model DeliveryZone {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  charge    Decimal  @db.Decimal(10, 2)
  /// "১–২ দিন"
  estimate  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  addresses DeliveryAddress[]

  @@schema("shop")
}

/// A buyer's saved addresses (at most 10). Orders copy the address, so editing it later
/// never changes an order.
model DeliveryAddress {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// ref auth.User
  userId        String   @db.Uuid
  label         String?
  recipientName String
  /// E.164 (+8801XXXXXXXXX). Never logged.
  phone         String
  zoneId        String   @db.Uuid
  area          String
  addressLine   String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@schema("shop")
}

model Order {
  id                     String             @id @default(uuid(7)) @db.Uuid
  /// "OD-2611-0042"
  code                   String             @unique
  /// ref auth.User (who ordered and pays)
  userId                 String             @db.Uuid
  /// ref users.PatientProfile (whose care it is for)
  patientId              String             @db.Uuid
  status                 OrderStatus
  paymentMethod          OrderPaymentMethod
  /// true once the online payment succeeded.
  isPaid                 Boolean            @default(false)
  subtotal               Decimal            @db.Decimal(10, 2)
  deliveryCharge         Decimal            @db.Decimal(10, 2)
  total                  Decimal            @db.Decimal(10, 2)
  /// Sum of (MRP − price) × qty, for the receipt.
  savings                Decimal            @default(0) @db.Decimal(10, 2)
  recipientName          String
  /// E.164. Never logged.
  phone                  String
  zoneName               String
  area                   String
  addressLine            String
  note                   String?
  holdExpiresAt          DateTime?          @db.Timestamptz(3)
  prescriptionCheck      PrescriptionCheck
  /// ref prescriptions.Prescription (an ISSUED one of patientId)
  prescriptionId         String?            @db.Uuid
  /// Private WebP: a photo of a paper prescription.
  prescriptionStorageKey String?
  prescriptionReviewNote String?
  /// ref auth.User (staff)
  prescriptionReviewedBy String?            @db.Uuid
  cancelReason           String?
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  items          OrderItem[]
  events         OrderEvent[]
  stockMovements StockMovement[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([prescriptionCheck])
  @@schema("shop")
}

/// A product line, copied at order time (later price or name changes never touch it).
model OrderItem {
  id                   String  @id @default(uuid(7)) @db.Uuid
  orderId              String  @db.Uuid
  productId            String  @db.Uuid
  name                 String
  packSize             String?
  unitPrice            Decimal @db.Decimal(10, 2)
  mrp                  Decimal @db.Decimal(10, 2)
  qty                  Int
  lineTotal            Decimal @db.Decimal(10, 2)
  requiresPrescription Boolean

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@schema("shop")
}

/// The order's timeline (every status change, with who and why).
model OrderEvent {
  id        String      @id @default(uuid(7)) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  /// ref auth.User; null for the system (payment, expiry).
  byUserId  String?     @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@schema("shop")
}

model ShopBanner {
  id              String         @id @default(uuid(7)) @db.Uuid
  title           String
  /// Public WebP.
  imageStorageKey String?
  linkType        BannerLinkType @default(NONE)
  linkValue       String?
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  startsAt        DateTime?      @db.Timestamptz(3)
  endsAt          DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@schema("shop")
}

/// Hospitals and labs that give our users a discount (shown on home).
model DiscountPartner {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String
  offerText      String
  description    String?
  address        String?
  /// E.164, the partner's public number.
  phone          String?
  /// Public WebP.
  logoStorageKey String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@schema("shop")
}
