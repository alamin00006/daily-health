# Copy to .env. Expo inlines EXPO_PUBLIC_* variables into the app bundle at build time,
# so never put secrets here.

# Base URL of the NestJS API (without /api/v1).
#   Android emulator:     http://10.0.2.2:3000
#   iOS simulator:        http://localhost:3000
#   Real phone (Expo Go): http://<your PC's LAN IP>:3000, e.g. http://192.168.0.105:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
